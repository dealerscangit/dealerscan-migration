{
  "manifest_version": 3,
  "name": "DealerScan",
  "version": "3.12",
  "description": "Upload customer documents from Google Drive to Tekion deal jacket",
  "permissions": [
    "storage",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://app.tekioncloud.com/*",
    "https://www.googleapis.com/*",
    "https://script.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DealerScan"
  },
  "content_scripts": [
    {
      "matches": ["https://app.tekioncloud.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.html", "overlay.js", "overlay.css", "icons/*"],
      "matches": ["https://app.tekioncloud.com/*"]
    }
  ],
  "oauth2": {
    "client_id": "381110617094-mpt3tn3b2nlqj10422gcqnphimbs90ik.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive",
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}
